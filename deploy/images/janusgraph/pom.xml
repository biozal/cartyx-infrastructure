    <dependency><groupId>org.apache.tinkerpop</groupId><artifactId>gremlin-core</artifactId><version>${tinkerpop.version}</version></dependency>
    <dependency><groupId>org.apache.tinkerpop</groupId><artifactId>gremlin-util</artifactId><version>${tinkerpop.version}</version></dependency>
    <dependency><groupId>org.apache.tinkerpop</groupId><artifactId>gremlin-language</artifactId><version>${tinkerpop.version}</version></dependency>
